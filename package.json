{
  "name": "directory-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build -w apps/web --",
    "dev": "npm run dev -w apps/web --",
    "sync-sites": "node scripts/sync-sites.ts",
    "test:db": "node supabase/tests/run.mjs",
    "test:core": "vitest run --root packages/core",
    "test:scripts": "vitest run --root scripts",
    "test": "npm run typecheck && npm run test:db && npm run test:core && npm run test:scripts && npm run test:web && npm run test:admin",
    "typecheck": "tsc -p . && tsc -p apps/admin",
    "test:web": "vitest run --root apps/web",
    "test:admin": "vitest run --root apps/admin",
    "build:admin": "npm run build -w @directory-engine/admin",
    "dev:admin": "npm run dev -w @directory-engine/admin",
    "dev:admin:demo": "npm run dev:demo -w @directory-engine/admin"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
