---
// Every page's shell: head (title, robots, canonical, brand colors), header, footer.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TrackClicks from "../components/TrackClicks.astro";
import { site } from "../lib/site.ts";
import { hasGoLink } from "../lib/affiliate.ts";
import { DISCLOSURE_LINE } from "../lib/info.ts";

interface Props {
  title: string;
  /** Absolute canonical URL. Omitted only on the 404 page, which has no URL of its own. */
  canonical?: string;
  /** From the plan's `indexable` flag. false = noindex,follow. */
  indexable: boolean;
}
const { title, canonical, indexable } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
// Rule 10: a page with any /go/ link shows the disclosure line at the top, and no other page does.
// Deciding from the rendered content covers every page type (ship-to-you, guides, later list pages).
const content = await Astro.slots.render("default");
const disclose = hasGoLink(content);
const brand = `:root{--brand:${site.brand.primary};--accent:${site.brand.accent}}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {!indexable && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.brand.primary} />
    <style set:html={brand}></style>
  </head>
  <body>
    <Header />
    <main id="main">
      {disclose && <p class="disclosure" data-disclosure>{DISCLOSURE_LINE}</p>}
      <Fragment set:html={content} />
    </main>
    <Footer />
    <TrackClicks />
  </body>
</html>
