---
import { logo, site } from "../lib/site.ts";
---
<header class="site-header">
  <div class="wrap">
    <a class:list={["site-name", { "has-logo": !!logo }]} href="/" aria-label={logo?.includesName ? site.name : undefined}>
      {logo?.kind === "svg" && <span class="logo" aria-hidden="true" set:html={logo.svg} />}
      {logo?.kind === "png" && <img class="logo" src={logo.href} alt="" />}
      {!logo?.includesName && <span>{site.name}</span>}
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href="/add-your-shop/">Add your shop</a>
    </nav>
  </div>
</header>
