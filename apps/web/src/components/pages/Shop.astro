---
// A shop in this site's angle (docs/SPEC.md, Shop page): core fields with their checks, capability
// tags, the angle's facts grouped by fact group with a check line each, "Not checked yet" for angle
// facts the shop lacks, report-a-change and claim links, and LocalBusiness structured data.
// The report-a-change form posts to the `report-change` Edge Function; the claim link opens
// /add-your-shop/ with this shop picked (T11).
import type { Page } from "@directory-engine/core";
import { canonical, capabilityName, data, listingsFor, site } from "../../lib/site.ts";
import { claimHref } from "../../lib/forms.ts";
import ReportChange from "../forms/ReportChange.astro";
import {
  NOT_CHECKED, coreCheck, directionsUrl, fullAddress, hoursRows, jsonLdText, localBusinessJsonLd,
  shopFactGroups, telHref, type Hours,
} from "../../lib/shop.ts";
interface Props { page: Page; title: string }
const { page } = Astro.props;
const shop = listingsFor(page)[0];
const groups = shopFactGroups(site, data.vocabulary, shop);
const ld = jsonLdText(localBusinessJsonLd(site, data.vocabulary, shop, canonical(page.path)));
const addressCheck = coreCheck(shop, "address");
const phoneCheck = coreCheck(shop, "phone");
const websiteCheck = coreCheck(shop, "website");
---
<article class="shop">
  <header class="shop-head">
    <h1>{shop.name}</h1>
    <p class="shop-city">{shop.city}, {shop.state}</p>
    <ul class="tags" aria-label="What this shop does">
      {shop.capabilities.map((c) => <li>{capabilityName(c)}</li>)}
    </ul>
    <p class="shop-actions">
      {shop.phone && <a class="btn btn-primary" href={telHref(shop.phone)} data-track="call" data-listing={shop.id}>Call {shop.phone}</a>}
      {shop.website && <a class="btn" href={shop.website} rel="noopener" target="_blank" data-track="website" data-listing={shop.id}>Website</a>}
      {directionsUrl(shop) && <a class="btn" href={directionsUrl(shop)} data-track="directions" data-listing={shop.id} target="_blank" rel="noopener">Directions</a>}
    </p>
  </header>

  <section class="fact-group" data-group="contact">
  <h2 class="label">Contact</h2>

  <dl class="facts core">
    <div>
      <dt>Address</dt>
      <dd>
        <span class="address">{fullAddress(shop)}</span><br />
        <a class="directions" href={directionsUrl(shop)} data-track="directions" data-listing={shop.id} target="_blank" rel="noopener">Directions</a>
        {addressCheck && <span class="check">{addressCheck}</span>}
      </dd>
    </div>
    <div>
      <dt>Phone</dt>
      <dd>
        {shop.phone ? <a href={telHref(shop.phone)} data-track="call" data-listing={shop.id}>{shop.phone}</a> : NOT_CHECKED}
        {shop.phone && phoneCheck && <span class="check">{phoneCheck}</span>}
      </dd>
    </div>
    <div>
      <dt>Website</dt>
      <dd>
        {shop.website ? <a href={shop.website} rel="noopener" data-track="website" data-listing={shop.id}>{shop.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a> : NOT_CHECKED}
        {shop.website && websiteCheck && <span class="check">{websiteCheck}</span>}
      </dd>
    </div>
  </dl>
  </section>

  {groups.map((g) => (
    <section class="fact-group" data-group={g.group}>
      <h2 class="label">{g.label}</h2>
      <dl class="facts">
        {g.rows.map((r) => (
          <div data-fact={r.key} class={r.fact ? (r.fact.stale ? "stale" : undefined) : "unknown"}>
            <dt>{r.label}</dt>
            <dd>
              {!r.fact ? (
                <span class="not-checked">{NOT_CHECKED}</span>
              ) : r.type === "hours" ? (
                <table class="hours">
                  <tbody>
                    {hoursRows(r.fact.value as Hours).map((h) => <tr><th scope="row">{h.day}</th><td>{h.text}</td></tr>)}
                  </tbody>
                </table>
              ) : r.type === "url" ? (
                <a href={String(r.fact.value)} rel="noopener">{String(r.fact.value)}</a>
              ) : (
                r.text
              )}
              {r.check && <span class="check">{r.check}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <section class="shop-help" id="report">
    <h2>Something wrong or missing?</h2>
    <ReportChange listingId={shop.id} returnPath={page.path} />
    <p><a href={claimHref(shop.id)}>Is this your shop?</a> Claim it to add or correct details.</p>
  </section>
</article>
<script type="application/ld+json" is:inline set:html={ld}></script>

<style>
  .shop { max-width: 52rem; }
  .shop-head { padding-bottom: 1.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--line); }
  .shop-head h1 { margin-bottom: 0.25rem; }
  .shop-city { margin: 0 0 0.85rem; font-size: 1.1rem; color: var(--muted); }
  .shop-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; }

  .fact-group { margin-top: 1.75rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .fact-group > h2.label { margin: 0; padding: 0.7rem 1.1rem; background: var(--surface); border-bottom: 1px solid var(--line); border-radius: var(--radius) var(--radius) 0 0; font-stretch: 100%; line-height: 1.5; }
  .facts { margin: 0; padding: 0 1.1rem; }
  .facts > div { padding: 0.8rem 0; }
  .facts > div + div { border-top: 1px solid var(--line); }
  .facts dt { font-weight: 650; font-size: 0.95rem; color: var(--ink-2); }
  .facts dd { margin: 0.2rem 0 0; overflow-wrap: anywhere; font-weight: 600; }
  .check { display: block; margin-top: 0.15rem; color: var(--muted); font-size: 0.8rem; font-weight: 400; }
  .stale .check { color: #8a4b00; }
  .not-checked { color: var(--muted); font-style: italic; font-weight: 400; font-size: 0.95rem; }
  .directions { display: inline-block; margin: 0.15rem 0; font-weight: 400; }
  .hours { border-collapse: collapse; font-weight: 400; }
  .hours th { text-align: left; font-weight: 600; padding: 0.1rem 1.25rem 0.1rem 0; }
  .hours td { padding: 0.1rem 0; }

  .shop-help { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .shop-help h2 { margin-top: 0; }
  .shop-help p { margin: 0.4rem 0; }
  @media (min-width: 48rem) {
    .facts > div { display: grid; grid-template-columns: 15rem 1fr; gap: 1rem; align-items: baseline; }
    .facts dd { margin: 0; }
  }
</style>
