---
// Home (docs/SPEC.md): the site's list pages per metro with listing counts, and the cities covered.
// Everything shown comes from buildHomeView(), which reads the plan and the loaded data only; the
// only sentences are built from that data (rule 4).
import type { Page } from "@directory-engine/core";
import { buildHomeView } from "../../lib/hub.ts";
import { data, pages, pageTitle, site } from "../../lib/site.ts";
interface Props { page: Page; title: string }
const { title } = Astro.props;
const view = buildHomeView({ site, listings: data.listings, vocabulary: data.vocabulary, plan: pages, titleOf: pageTitle });
---
<header class="hero">
  <h1>{title}</h1>
  <p class="lead">{view.lead.join(" ")}</p>
</header>

<div class="metros">
  {view.metros.map((m) => (
    <section class="metro" data-metro={m.slug} aria-labelledby={`metro-${m.slug}`}>
      <div class="metro-head">
        <h2 id={`metro-${m.slug}`}>{m.href ? <a href={m.href}>{m.name}</a> : m.name}</h2>
        <span class="metro-count" data-count={m.count}>{m.countText}</span>
      </div>
      {m.lists.length > 0 && (
        <ul class="hub-links">
          {m.lists.map((l) => (
            <li><a href={l.href}>{l.text}</a> <span class="muted" data-count={l.count}>{l.countText}</span></li>
          ))}
        </ul>
      )}
      {m.cities.length > 0 && (
        <p class="cities"><span class="cities-label">Cities:</span> {m.cities.map((c) => c.name).join(", ")}</p>
      )}
    </section>
  ))}
</div>

<style>
  .hero { padding: 1.5rem 0 2.25rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .hero h1 { font-size: 2.6rem; font-stretch: 120%; max-width: 20ch; }
  .hero .lead { font-size: 1.2rem; margin: 0; }
  .metros { display: grid; gap: 1rem; }
  .metro { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.1rem 1rem; }
  .metro-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-bottom: 0.75rem; }
  .metro h2 { margin: 0; font-size: 1.4rem; }
  .metro-count { font-size: 0.85rem; font-weight: 650; color: var(--muted); white-space: nowrap; }
  .hub-links { list-style: none; padding: 0; margin: 0 0 0.75rem; }
  .hub-links li {
    position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem;
    padding: 0.7rem 2.2rem 0.7rem 0.85rem; border-radius: var(--radius); background: var(--surface);
  }
  .hub-links li::after { content: "92"; position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--accent); font-weight: 700; }
  .hub-links a { font-weight: 650; text-decoration: none; }
  .hub-links a::before { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .hub-links li:hover { background: var(--ink); }
  .hub-links li:hover a, .hub-links li:hover::after { color: #fff; }
  .hub-links li:hover .muted { color: #d6d6d0; }
  .hub-links .muted { font-size: 0.9rem; }
  .hub-links li + li { margin-top: 0.4rem; }
  .cities {
    margin: auto 0 0; font-size: 0.85rem; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cities-label { font-weight: 650; color: var(--ink-2); }
  @media (min-width: 48rem) {
    .hero { padding: 3rem 0 3rem; }
    .hero h1 { font-size: 4rem; }
    .metros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 66rem) {
    .metros { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
