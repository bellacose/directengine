---
// Operator from the site config (null until Chris sets it), links to the info pages, and the GeoNames credit (D9).
import { INFO_PAGES } from "@directory-engine/core";
import { site } from "../lib/site.ts";
import { INFO_TITLES } from "../lib/info.ts";
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>
        {site.operator ? <>{site.name} is run by {site.operator.name}.</> : <>{site.name}. Operator not set yet.</>}
      </p>
    </div>
    <nav aria-label="About this site">
      <ul class="footer-links">
        {INFO_PAGES.map((slug) => <li><a href={`/${slug}/`}>{INFO_TITLES[slug]}</a></li>)}
      </ul>
    </nav>
    <p class="footer-credit">
      Locations use ZIP code data from <a href="https://www.geonames.org/">GeoNames</a>,
      licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
    </p>
  </div>
</footer>
