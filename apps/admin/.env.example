# Admin app (apps/admin). Set these in the host's build settings for the admin deploy.
# Both are safe in client code: the publishable key has no access on its own (anon gets nothing),
# and every query runs as the signed-in user under row level security.
# NEVER put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
